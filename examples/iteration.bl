namespace workflows;
version "1";

start_event number_start { output input: Number; }
start_event list_start { output values: List<Number>; }
end_event done { input result: List<Number>; }
error_event stopped {}
xor_split gate {}
xor_join joined { split gate; input value: Number; output result: Number; }

decision_task echo {
  input input: Number;
  output result: Number = value;
  literal_expression value { output result: Number; expression input; }
}

process repeat_until_timeout {
  deadline queued "2s";
  flow number_start -> gate;
  flow gate -> echo when number_start.input > 0;
  flow gate -> stopped else;
  flow echo -> joined;
  flow joined -> gate;
  bind number_start.input -> echo.input;
  bind echo.result -> joined.value;
}

process gather {
  multi_instance echo each list_start.values parallel;
  flow list_start -> echo;
  flow echo -> done;
  bind list_start.values -> echo.input;
  bind echo.result -> done.result;
}
