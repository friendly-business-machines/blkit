namespace pricing;
version "1.0";

start_event start { output amount: Number; }

decision_task price {
  input amount: Number;
  output result: Number = quoted;

  decision_table tier {
    output result: Number;
    policy FIRST;
    input value: Number = amount;
    output price: Number;
    rule value > 100 -> 5;
    default 2;
  }

  context quoted {
    output result: Number;
    entry offer: Number = tier.result;
    result offer;
  }
}

end_event done { input result: Number; }

process quote {
  flow start -> price;
  flow price -> done;
  bind start.amount -> price.amount;
  bind price.result -> done.result;
}
