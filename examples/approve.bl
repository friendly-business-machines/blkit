namespace orders
version "1.0"

type Order:
  total: Number
  blocked: Bool

enum Decision:
  approved
  review

task decide(input: Order) -> Decision:
  if input.total > 1000 and not input.blocked:
    return Decision.review
  else:
    return Decision.approved

process approve(input: Order) -> Decision:
  node start = start
  node decision = task decide(input)
  node done = end
  link start -> decision
  link decision -> done(decision)
