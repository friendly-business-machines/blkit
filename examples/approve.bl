namespace orders;
version "1.0";

Order = {total: Number, blocked: Bool};

enum Decision:
  approved;
  review;

start_event start { output input: Order; }
end_event done { input result: Decision; }

decision_task decide {
  input input: Order;
  output result: Decision = choice;
  decision_table choice {
    output result: Decision;
    policy FIRST;
    input amount: Number = input.total;
    input blocked: Bool = input.blocked;
    output decision: Decision;
    rule amount > 1000 and not blocked -> Decision.review;
    default Decision.approved;
  }
}

process approve {
  flow start -> decide;
  flow decide -> done;
  bind start.input -> decide.input;
  bind decide.result -> done.result;
}
