namespace orders;
version "1.0";

start_event start { output input: Number; }
end_event child_done { input result: Number; }
end_event done { input result: Number; }
end_event error_done { input result: Number; }
end_event cancel_done { input result: Number; }
end_event terminate_done { input result: Number; }
error_event failed {}
cancel_event cancelled {}
terminate_event halted {}
xor_split gate {}
xor_join joined { split gate; input value: Number; output result: Number; }
subprocess called { process child; input input: Number; output result: Number; }

decision_task echo { input input: Number; output result: Number = value; literal_expression value { output result: Number; expression input; } }
decision_task recover_error { input input: Number; output result: Number = value; literal_expression value { output result: Number; expression 100; } }
decision_task recover_cancel { input input: Number; output result: Number = value; literal_expression value { output result: Number; expression 200; } }
decision_task recover_terminate { input input: Number; output result: Number = value; literal_expression value { output result: Number; expression 300; } }

process child {
  flow start -> gate;
  flow gate -> failed when start.input == 0;
  flow gate -> cancelled when start.input < 0;
  flow gate -> halted when start.input > 10;
  flow gate -> echo else;
  flow echo -> joined;
  flow joined -> child_done;
  bind start.input -> echo.input;
  bind echo.result -> joined.value;
  bind joined.result -> child_done.result;
}

process parent {
  flow start -> called;
  flow called -> done;
  flow called -> recover_error on error;
  flow called -> recover_cancel on cancel;
  flow called -> recover_terminate on terminate;
  flow recover_error -> error_done;
  flow recover_cancel -> cancel_done;
  flow recover_terminate -> terminate_done;
  bind start.input -> called.input;
  bind start.input -> recover_error.input;
  bind start.input -> recover_cancel.input;
  bind start.input -> recover_terminate.input;
  bind called.result -> done.result;
  bind recover_error.result -> error_done.result;
  bind recover_cancel.result -> cancel_done.result;
  bind recover_terminate.result -> terminate_done.result;
}
