{
  // Friendly label shown in VS Code UI (Dev Containers: Reopen in Container, etc.).
  // This is display-only and does not affect build/runtime behavior.
  "name": "blkit (Ubuntu 24.04 LTS)",

  // Build configuration for the container image used by VS Code.
  // VS Code runs `docker build` with these settings when creating/rebuilding.
  "build": {
    // Dockerfile path relative to this file (`.devcontainer/devcontainer.json`).
    "dockerfile": "Dockerfile",

    // Build context is project root (`..`) rather than `.devcontainer` folder.
    // This allows COPY access to repository files if future Dockerfile steps need them.
    // User-related values are defined in Dockerfile ARG defaults to avoid duplication.
    "context": ".."
  },

  // VS Code settings/extensions applied when opening this project in the dev container.
  "customizations": {
    "vscode": {
      "extensions": [
        // Claude Code integration.
        "anthropic.claude-code",
        // Go language support (syntax, gopls, debugging).
        "golang.go",
        // Inline hadolint warnings/errors in Dockerfiles as you edit.
        "exiasr.hadolint",
        // Docker/container explorer and management UI (build, run, inspect images/containers).
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // User account VS Code uses for terminals, tasks, debug sessions, and extensions.
  // Must match a user that exists in the built image.
  "remoteUser": "vscode",

  // On container start, Dev Containers may update remoteUser UID/GID to match host.
  // Goal: avoid bind-mount file permission issues when host and container IDs differ.
  // Most impactful on Linux/macOS hosts; typically low/no-op impact on Windows hosts.
  "updateRemoteUserUID": true,

  // Bind-mount the host Docker daemon socket into the container (Docker-outside-of-Docker).
  // This lets the Docker CLI in the container delegate builds/runs to the host daemon,
  // so `docker build -f .devcontainer/Dockerfile .` works from inside the container.
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // Reconcile the container's `docker` group GID with the host socket's actual group GID
  // on every container start (the socket is re-exposed by the host daemon each start, and
  // its GID varies by host OS). This must live in postStartCommand rather than an image
  // ENTRYPOINT: VS Code Dev Containers defaults `overrideCommand: true` for Dockerfile
  // configs, replacing the image's ENTRYPOINT/CMD with its own keep-alive command, so a
  // baked-in entrypoint never runs. postStartCommand runs regardless (and sudo is passwordless).
  // The script also handles the root-owned-socket (GID 0) case; see reconcile-docker-gid.sh.
  "postStartCommand": "sudo /usr/local/bin/reconcile-docker-gid.sh"
}
