{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",

  // Friendly label shown in VS Code UI (Dev Containers: Reopen in Container, etc.).
  // This is display-only and does not affect build/runtime behavior.
  "name": "blkit (Ubuntu 26.04 LTS)",

  // Build configuration for the container image used by VS Code.
  // VS Code runs `docker build` with these settings when creating/rebuilding.
  "build": {
    // Dockerfile path relative to this file (`.devcontainer/devcontainer.json`).
    "dockerfile": "Dockerfile",

    // Build context is project root (`..`) rather than `.devcontainer` folder.
    // This allows COPY access to repository files if future Dockerfile steps need them.
    // User-related values are defined in Dockerfile ARG defaults to avoid duplication.
    "context": ".."
  },

  // VS Code settings/extensions applied when opening this project in the dev container.
  "customizations": {
    "vscode": {
      "extensions": [
        // Claude Code integration.
        "anthropic.claude-code",
        // Pendant sidebar integration for the pi coding agent.
        "cdervis.vscode-pi",
        // Inline hadolint warnings/errors in Dockerfiles as you edit.
        "exiasr.hadolint",
        // Docker/container explorer and management UI (build, run, inspect images/containers).
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // User account VS Code uses for terminals, tasks, debug sessions, and extensions.
  // Must match a user that exists in the built image.
  "remoteUser": "vscode",

  // Podman publishes Testcontainers ports on the host, not the container's loopback.
  "containerEnv": { "BLKIT_TESTCONTAINERS_HOST": "host.containers.internal" },

  // Dev Containers commonly changes the remote user's UID/GID to match the
  // host and avoid bind-mount permission problems. That cannot work when the
  // host UID (e.g. 1000) already belongs to another image user (ubuntu here).
  // Keep vscode at 1001:1001 and let rootless Podman map the host user to it.
  "updateRemoteUserUID": false,

  // In rootless Podman, map each contributor's host UID/GID to vscode's 1001:1001.
  // Bind-mounted workspace files then remain owned by that contributor on the host.
  "runArgs": ["--userns=keep-id:uid=1001,gid=1001"],

  // Bind-mount the host's rootless Podman API socket at Docker's conventional
  // socket path. The Docker-compatible API lets the Docker CLI in the container
  // delegate builds/runs to host Podman. XDG_RUNTIME_DIR resolves on the host
  // before the container is created.
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/var/run/docker.sock,type=bind"
  ],

  // Keep the image ENTRYPOINT: it grants vscode access to the mounted socket
  // before VS Code starts its server. The image CMD keeps the container alive.
  "overrideCommand": false,

  // Runs on the HOST before the container starts, on every start. Dev Containers
  // forwards the host's keyboxd socket (where public keys live) but only pipes the
  // socket — it never launches the daemon, which the host starts on demand. If the
  // host keyboxd is cold the forward returns EOF, gpg silently falls back to an
  // empty container-local keybox, and commit signing fails with "No secret key".
  // Launching it here guarantees a live target. See the GnuPG notes in Dockerfile.
  // Failure is swallowed deliberately: a non-zero initializeCommand aborts container
  // start, and contributors without GnuPG installed must still be able to attach.
  "initializeCommand": "gpgconf --launch keyboxd || exit 0"
}
